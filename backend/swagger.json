  "info": {
    "title": "Y-Mad API",
    "description": "\n      API complete du site Y-Mad (Youthful Madagascar)\n\n      Fonctionnalites principales :\n      - Authentification (7 roles: super_admin, admin, staff, member, volunteer, partner, visitor)\n      - Gestion des membres avec cartes QR\n      - Projets et indicateurs d'impact\n      - Evenements avec inscriptions et QR codes\n      - Module emploi (offres et candidatures)\n      - Dons Mobile Money (MVola, Orange Money)\n      - Blog bilingue (Francais/Malagasy)\n      - Gestion dynamique des pages\n      - Journal d'audit complet\n    ",
    "version": "1.0.0",
    "contact": {
      "name": "Y-Mad Association",
      "url": "https://y-mad.mg",
      "email": "contact@y-mad.mg"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Authentification et gestion des utilisateurs"
    },
    {
      "name": "Members",
      "description": "Gestion des adhesions et cartes membres"
    },
    {
      "name": "Projects",
      "description": "Gestion des projets Y-Mad"
    },
    {
      "name": "Jobs",
      "description": "Module emploi - Offres et candidatures"
    },
    {
      "name": "Events",
      "description": "Gestion des evenements et inscriptions"
    },
    {
      "name": "Donations",
      "description": "Gestion des dons et paiements"
    },
    {
      "name": "Blog",
      "description": "Articles et actualites"
    },
    {
      "name": "Pages",
      "description": "Gestion dynamique du contenu"
    },
    {
      "name": "Upload",
      "description": "Upload de fichiers"
    }
  ],
