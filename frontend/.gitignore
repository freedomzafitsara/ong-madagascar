reports/
.bundle-stats.json

# =====================================================
# FICHIERS PERSONNELS
# =====================================================

# Personal notes
*.notes
TODO.md
PERSONAL_*

# Local scripts
scripts/local/
*.local.js
*.local.ts

# =====================================================
# BASE DE DONNEES
# =====================================================

# Base de donnees locales
*.db
*.sqlite
*.sqlite3
data.db

# =====================================================
# FICHIERS SPECIFIQUES AU PROJET
# =====================================================

# Y-Mad specific
dump.rdb
temp-*.json
export-*.csv
import-*.csv

# Rapports generes
reports-export/
exports/

# Backups des donnees
backup-data/

# =====================================================
# EXCEPTIONS (fichiers a garder malgre les regles)
# =====================================================

# Garder les fichiers example
!.env.example
!.gitkeep
!**/.gitkeep

# Garder les configurations par defaut
!*.default.js
!*.default.ts
!*.config.example.js

# =====================================================
# NOTE: Ne pas versionner les fichiers sensibles
# =====================================================

# Les fichiers suivants ne doivent JAMAIS etre commites:
# - .env.local (contient les cles API)
# - *.pem (certificats)
# - node_modules/ (trop lourd)
# - .next/ (genere automatiquement)
# - package-lock.json (optionnel, selon politique d'equipe)