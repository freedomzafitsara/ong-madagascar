# Cache directories
.cache/
.parcel-cache/
.turbo/
.rollup.cache/
.eslintcache
.stylelintcache
.prettiercache

# Temp files
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.bak

